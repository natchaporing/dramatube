# ---- Required -------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dramatube
AUTH_SECRET=generate-with-openssl-rand-base64-32

# The public address of the site. Used for absolute links in share/embed
# codes, Open Graph tags, and the publishing API's responses.
# PUBLIC_APP_URL=https://dramatube.example.com

# ---- Media storage --------------------------------------------------------
# "local" writes to ./.storage and streams through /api/media with Range
# support (fine for development and a single server with a volume).
# "s3" targets any S3-compatible bucket. Cloudflare R2 is recommended: video
# egress is free there and is otherwise the largest line item of a video site.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1
# Set only for a PUBLIC bucket. Unset, media is served through /api/media,
# which checks a private video's owner before redirecting to a signed URL.
# S3_PUBLIC_BASE_URL=

# Largest accepted upload, in megabytes.
UPLOAD_MAX_MB=2048

# ---- Who moderates -------------------------------------------------------
# Nobody becomes an admin by signing up. Grant the role from a shell on the
# server, once the account exists:  pnpm admin:grant you@example.com

# ffmpeg/ffprobe are used, when present, to read a video's real duration and
# size, to cut a thumbnail for uploads that arrive without one, and to move an
# MP4's index to the front so playback starts before the download finishes.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ---- Payments (hybrid) ----------------------------------------------------
# PromptPay through Omise (Opn Payments): a QR the viewer scans, charged as a
# percentage rather than Stripe's fixed per-QR fee. Ask Omise to enable
# PromptPay on the account, then point its webhook at /api/payments/omise.
# OMISE_SECRET_KEY=skey_...
#
# Cards through Stripe Checkout. Both values are required: without the
# webhook secret nothing could confirm a payment, so Stripe is not offered.
# Webhook: /api/payments/stripe with checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, charge.refunded, charge.dispute.created.
# With no Omise key, Stripe takes PromptPay too.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# A stand-in that marks a top-up paid at the press of a button, for local
# development and the e2e check. NEVER set it in production.
# ALLOW_DEV_PAYMENTS=1
#
# Selling episodes needs a PRIVATE bucket (leave S3_PUBLIC_BASE_URL unset for
# video files): in a public bucket a buyer could share a paid file's address.

